$TTL	604800
@	IN	SOA	ns1.example.org. hostmaster.example.org. (
			      1		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	ns1.example.org.
1	IN	PTR	ns1.example.org.
2       IN      PTR     prox1.example.org.
3	IN      PTR     alice.example.org.
