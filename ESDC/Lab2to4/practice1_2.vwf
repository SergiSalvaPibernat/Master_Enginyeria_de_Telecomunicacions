USER_TYPE("__main:MAIN|state")
{
	VALUES = "Undefined", "state.s0_Wait", "state.Enter_Code", "state.W_Code", "state.Start_Game";
}

USER_TYPE("__game:GAME|state")
{
	VALUES = "Undefined", "state.s0_Wait", "state.W_Tx1", "state.S_RDY", "state.W_RDY";
}

USER_TYPE("__register_bank:GUESS_CODE|state")
{
	VALUES = "Undefined", "state.s0_Wait";
}

USER_TYPE("__register_bank:USER_CODE|state")
{
	VALUES = "Undefined", "state.s0_Wait", "state.W_Keypress", "state.Get_Key", "state.s_END";
}

