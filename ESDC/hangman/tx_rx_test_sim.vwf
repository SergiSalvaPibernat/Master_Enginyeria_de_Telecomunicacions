{
	NODE
	{
		REPEAT = 1;
		LEVEL st.w_frame_code FOR 72.933;
		LEVEL st.s_rdy FOR 20.0;
		LEVEL st.w_tx_empty1 FOR 20.0;
		LEVEL st.s_frame_id FOR 20.0;
